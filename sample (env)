# ==============================================================================
# 🚀 Production Environment Variables Template (.env)
# Copy this file to .env before starting the stack:
#   cp "sample (env)" .env
# ==============================================================================

# Timezone
TZ=Asia/Ho_Chi_Minh

# Site Domain (Đặt :80 nếu chạy IP hoặc local; đặt domain ví dụ carquiz.example.com để Caddy tự cấp SSL HTTPS)
SITE_ADDRESS=:80
APP_PORT=80

# Quản trị viên khởi tạo lần đầu (Seed tự động nếu chưa có Admin trong database)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@2026!
ADMIN_DEFAULT_FULLNAME=Quản trị viên

# JWT Secret Key (Tối thiểu 32 ký tự, dùng để mã hóa và ký access token)
JWT_SECRET_KEY=QuizCarLicense_SuperSecureProductionSigningKey_2026!

# PostgreSQL Database Settings
POSTGRES_DB=quizcarlicense
POSTGRES_USER=devuser
POSTGRES_PASSWORD=ChangeYourDbPassword123!
POSTGRES_PORT=5432
POSTGRES_BIND_IP=127.0.0.1
